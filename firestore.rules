rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────

    // Check if the request is from an authenticated user
    function isSignedIn() {
      return request.auth != null;
    }

    // Get the requesting user's UID
    function uid() {
      return request.auth.uid;
    }

    // Check if the user is a member of the specified organization
    function isOrgMember(orgId) {
      return isSignedIn() && exists(/databases/$(database)/documents/organizationMembers/$(orgId + '_' + uid()));
    }

    // Check if the user is a member of the organization associated with the resource
    // (Used when the document has an organizationId field)
    function isMemberOfResourceOrg() {
       return isSignedIn() && exists(/databases/$(database)/documents/organizationMembers/$(resource.data.organizationId + '_' + uid()));
    }

    // Check if the user will be a member of the organization associated with the *new* resource
    function isMemberOfNewResourceOrg() {
       return isSignedIn() && exists(/databases/$(database)/documents/organizationMembers/$(request.resource.data.organizationId + '_' + uid()));
    }


    // ─── Users Collection ─────────────────────────────────────────
    // Users can fetch individual profiles (team pages resolve co-members by
    // UID) but may never list the whole collection.
    // Users can write only their own profile document.
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && uid() == userId;
      allow delete: if false;
    }

    // ─── Organizations Collection ─────────────────────────────────
    // Read: Only members can read the org.
    // Create: Any authenticated user, but only as themselves (createdBy is
    //         what authorizes the bootstrap owner membership below).
    // Update: Only members can update the org.
    // Delete: Not allowed from client.
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create: if isSignedIn() && request.resource.data.createdBy == uid();
      allow update: if isOrgMember(orgId);
      allow delete: if false;
    }

    // ─── Organization Members Collection ──────────────────────────
    // Membership docs are keyed {orgId}_{uid}. Creation is only allowed for
    // YOUR OWN membership, and only via one of the two legitimate flows:
    //   1. Bootstrap: you created the organization (org.createdBy == you),
    //      taking the "owner" role.
    //   2. Invite: the membership references a live invite code for that org
    //      and takes exactly the invited role.
    // Anything else (writing yourself into an arbitrary org) is denied.
    match /organizationMembers/{memberId} {
      allow read: if isSignedIn() && (
        memberId.matches('.*_' + uid()) ||
        resource.data.userId == uid() ||
        isMemberOfResourceOrg()
      );
      allow create: if isSignedIn()
        && request.resource.data.userId == uid()
        && memberId == request.resource.data.organizationId + '_' + uid()
        && (
          (
            // Bootstrap owner for an org you just created
            request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.createdBy == uid()
          ) || (
            // Joining through a valid, unexpired invite for this org
            request.resource.data.inviteCode is string
            && exists(/databases/$(database)/documents/organizationInvites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/organizationInvites/$(request.resource.data.inviteCode)).data.organizationId == request.resource.data.organizationId
            && get(/databases/$(database)/documents/organizationInvites/$(request.resource.data.inviteCode)).data.role == request.resource.data.role
            && get(/databases/$(database)/documents/organizationInvites/$(request.resource.data.inviteCode)).data.expiresAt > request.time.toMillis()
          )
        );
      // No client-side updates: prevents members from escalating their own role.
      allow update: if false;
      // Leaving an org (deleting your own membership) is allowed.
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ─── Sessions Collection ──────────────────────────────────────
    // Read: Only members of the session's org can read it.
    // Create: Only members of the target org can create sessions for it.
    // Update: Only members of the active session's org can update it.
    // Delete: Only members of the session's org can delete it.
    match /sessions/{sessionId} {
      allow read: if isMemberOfResourceOrg();
      allow create: if isMemberOfNewResourceOrg();
      allow update: if isMemberOfResourceOrg();
      allow delete: if isMemberOfResourceOrg();

      // ─── Transcripts Subcollection ──────────────────────────────
      // Transcript lines inherit security from the parent session.
      match /transcripts/{transcriptId} {
        // We use get() here to check the parent document's organizationId
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/organizationMembers/$(get(/databases/$(database)/documents/sessions/$(sessionId)).data.organizationId + '_' + uid()));
        allow create: if isSignedIn() && exists(/databases/$(database)/documents/organizationMembers/$(get(/databases/$(database)/documents/sessions/$(sessionId)).data.organizationId + '_' + uid()));
        allow update: if false;
        allow delete: if isSignedIn() && exists(/databases/$(database)/documents/organizationMembers/$(get(/databases/$(database)/documents/sessions/$(sessionId)).data.organizationId + '_' + uid()));
      }
    }

    // ─── Displays Collection ──────────────────────────────────────
    // Same pattern as sessions.
    match /displays/{displayId} {
      allow read: if isMemberOfResourceOrg();
      allow create: if isMemberOfNewResourceOrg();
      allow update: if isMemberOfResourceOrg();
      // The dashboard supports deleting displays; scope it to org members.
      allow delete: if isMemberOfResourceOrg();
    }

    // ─── Organization Invites Collection ──────────────────────────
    // Invites are keyed by their code: fetching one requires knowing the
    // code, and listing the collection (code harvesting) is denied.
    match /organizationInvites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isMemberOfNewResourceOrg();
      allow update, delete: if false;
    }
  }
}
